{
  "name": "pms",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend",
    "dashboard/frontend",
    "dashboard/backend",
    "packages/booking-crm",
    "packages/regional-catalogue",
    "packages/site-content",
    "packages/ui"
  ],
  "scripts": {
    "clean:next": "node scripts/clean-next-cache.mjs",
    "sync:portal-data": "node -e \"const fs=require('fs');const s='data/channel-landing-pages.json';const d='packages/booking-crm/data/channel-landing-pages.json';fs.copyFileSync(s,d);console.log('Synced portal data to booking-crm package');\"",
    "dev": "concurrently -n site,api,dash,dash-api,gw -c blue,green,magenta,yellow,cyan \"npm run dev -w @pms/frontend\" \"npm run dev -w @pms/backend\" \"npm run dev -w @pms/dashboard-frontend\" \"npm run dev -w @pms/dashboard-backend\" \"node scripts/dev-gateway.mjs\"",
    "dev:fresh": "node scripts/clean-next-cache.mjs --kill-ports && npm run dev",
    "dev:all": "npm run dev",
    "dev:website": "npm run dev -w @pms/frontend",
    "open:site": "npm run dev:website",
    "dev:frontend": "npm run dev -w @pms/frontend",
    "dev:backend": "npm run dev -w @pms/backend",
    "dev:dashboard": "concurrently -n dash,dash-api -c magenta,yellow \"npm run dev -w @pms/dashboard-frontend\" \"npm run dev -w @pms/dashboard-backend\"",
    "build": "npm run build -w @pms/frontend && npm run build -w @pms/backend && npm run build -w @pms/dashboard-frontend && npm run build -w @pms/dashboard-backend",
    "lint": "npm run lint -w @pms/frontend && npm run lint -w @pms/backend && npm run lint -w @pms/dashboard-frontend && npm run lint -w @pms/dashboard-backend",
    "import:regional": "node scripts/import-regional-matrix.mjs",
    "validate:regional": "node scripts/validate-regional-catalogue.mjs",
    "test:regional": "npm run test -w @pms/frontend -- lib/regional-catalogue.test.ts lib/regional-checkout.integration.test.ts",
    "db:migrate": "node scripts/apply-supabase-migrations.mjs",
    "db:migrate:auth": "node scripts/apply-supabase-migrations.mjs --only-auth",
    "db:setup": "node scripts/setup-supabase-database.mjs",
    "db:apply-auth": "node scripts/apply-dashboard-one-auth.mjs",
    "db:check-supabase": "node scripts/check-supabase-auth.mjs",
    "sync:regional": "node scripts/sync-regional-catalogue-to-supabase.mjs",
    "spot-check:india-pmp": "node scripts/spot-check-india-pmp.mjs",
    "spot-check:checkout-api": "node scripts/spot-check-checkout-api.mjs",
    "qa:regional": "node scripts/qa-regional-matrix.mjs",
    "setup:env": "node scripts/setup-regional-env.mjs",
    "verify:regional-dev": "node scripts/verify-regional-dev.mjs",
    "test:legal-seo": "npm run test -w @pms/frontend -- lib/legal-seo.test.ts content/legal/index.test.ts",
    "audit:images": "node scripts/audit-images.mjs",
    "export:website-data": "node --import tsx scripts/export-website-data-snapshot.mjs",
    "seed:site-content": "node --import tsx scripts/seed-site-content.mjs",
    "build:cert-registry": "node --import tsx scripts/build-cert-registry-from-sitedata.mjs",
    "print:pathway-calendly-env": "node scripts/print-pathway-calendly-env-keys.mjs",
    "print:pathway-calendly-env:dotenv": "node scripts/print-pathway-calendly-env-keys.mjs --dotenv",
    "print:pathway-calendly-env:md": "node scripts/print-pathway-calendly-env-keys.mjs --markdown"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "http-proxy": "^1.18.1",
    "pg": "^8.21.0",
    "sharp": "^0.34.5",
    "tsx": "^4.19.4",
    "xlsx": "^0.18.5"
  }
}
